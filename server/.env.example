# Copy this file to server/.env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development
# The public site URL. Used for CORS, links in emails, canonical URLs and the sitemap.
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=boxel_store
# Set to true for a hosted MySQL database that requires TLS.
DB_SSL=false
# The provider's CA certificate (PEM text) when it uses a private CA, e.g. Aiven.
DB_SSL_CA=

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
# Forced to true automatically when NODE_ENV=production and CLIENT_URL starts with https://
SESSION_COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=boxel
SMTP_FROM_EMAIL=
# Receives new-order and enquiry notifications (can be overridden in Admin → Email settings).
ADMIN_EMAIL=

BUSINESS_NAME=boxel
BUSINESS_PHONE=+918310018733
BUSINESS_EMAIL=
BUSINESS_CITY=
BUSINESS_STATE=

# Optional: set to 1 when running behind a reverse proxy / load balancer (production default is 1).
# TRUST_PROXY=1
